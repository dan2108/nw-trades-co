# Copy this file to `.env.local` and fill in the values.

# --- Chat assistant (server) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the chat model. Defaults to claude-3-haiku-20240307 (cheapest).
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- WhatsApp handoff (client) ---
# The business WhatsApp number in INTERNATIONAL format, digits only (no +, no spaces).
# Default below is the Ofcom test range. Swap for the real number, e.g. 447911123456.
NEXT_PUBLIC_WHATSAPP_NUMBER=447700900123
