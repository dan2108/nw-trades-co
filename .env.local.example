# Copy this file to `.env.local` and fill in the value (optional).
#
# This demo's chat assistant is fully scripted (lib/demoBot.ts) — it needs NO
# API key and runs entirely in the browser. The only optional setting is the
# WhatsApp number the "Get Your Free Quote" button deep-links to.

# --- WhatsApp handoff (client) ---
# The business WhatsApp number in INTERNATIONAL format, digits only (no +, no spaces).
# Default is the Ofcom test range. Swap for the real number, e.g. 447911123456.
NEXT_PUBLIC_WHATSAPP_NUMBER=447700900123
